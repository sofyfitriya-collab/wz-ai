# Wajib: connection string PostgreSQL/Neon untuk menyimpan seluruh data aplikasi.
WZDATABASE=postgresql://user:password@host/database?sslmode=require

# Wajib: notifikasi Web Push.
# Generate dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Opsional: jika Anda ingin memakai AI eksternal OpenAI.
# Jika kosong, WZ AI Analyst akan memakai engine AI lokal bawaan di file server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WZ_USE_LOCAL_AI=true

# Disarankan untuk deployment produksi.
NODE_ENV=production