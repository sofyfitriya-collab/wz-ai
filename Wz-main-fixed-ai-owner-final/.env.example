# Wajib: connection string PostgreSQL/Neon untuk menyimpan seluruh data aplikasi.
WZDATABASE=postgresql://user:password@host/database?sslmode=require

# Wajib: notifikasi Web Push.
# Generate dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Wajib: AI Engine eksternal pada WZ AI Analyst.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Disarankan untuk deployment produksi.
NODE_ENV=production